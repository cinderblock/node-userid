{
  "name": "userid",
  "version": "2.0.0",
  "description": "Look up user and group ids and names in Node.js. Uses native POSIX bindings, not processes.",
  "keywords": [
    "uid",
    "gid",
    "user",
    "group",
    "passwd",
    "getpwnam",
    "posix",
    "native"
  ],
  "license": "Public Domain",
  "author": "Jen Andre <jandre@gmail.com>",
  "contributors": [
    "Cameron Tacklind <cameron@tacklind.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cinderblock/node-userid.git"
  },
  "bugs": "https://github.com/cinderblock/node-userid/issues",
  "homepage": "https://github.com/cinderblock/node-userid#readme",
  "type": "commonjs",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "prebuilds/",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "gypfile": false,
  "scripts": {
    "prepare": "tsc -p tsconfig.build.json",
    "build": "prebuildify --target node@22.12.0 --cwd native --out . --name userid --napi --strip --tag-libc --tag-armv && tsc -p tsconfig.build.json",
    "build:native": "prebuildify --target node@22.12.0 --cwd native --out . --name userid --napi --strip --tag-libc --tag-armv",
    "build:ts": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.mts",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "node scripts/clang-tidy.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "spelling": "cspell --no-progress \"**\"",
    "check": "bun run format:check && bun run spelling && bun run typecheck && bun run lint",
    "check:package": "publint --strict && attw --pack --profile node16",
    "prepublishOnly": "node scripts/guard-publish.cjs"
  },
  "dependencies": {
    "node-gyp-build": "^4.8.4"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.5",
    "cspell": "^10.4.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.1.0",
    "prebuildify": "^6.0.1",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "typescript": "^7.0.2"
  }
}
